{
  "name": "grafana-ui-testing",
  "version": "0.1.0",
  "private": true,
  "description": "UI functional testing platform for Grafana deployments backed by VictoriaMetrics",
  "scripts": {
    "env:up": "docker compose -f env/docker-compose.yml up -d",
    "env:down": "docker compose -f env/docker-compose.yml down -v",
    "env:seed": "tsx tests/fixtures/seed.ts",
    "env:setup": "npm run env:up && npm run env:wait && npm run env:seed",
    "env:wait": "tsx scripts/wait-for-services.ts",
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:report": "npx playwright show-report",
    "test:app": "npx playwright test --config app_tests/playwright.config.ts",
    "test:app:headed": "npx playwright test --config app_tests/playwright.config.ts --headed",
    "generate": "tsx services/generation/cli.ts",
    "codegen": "tsx scripts/codegen.ts",
    "ml:analyze": "python -m services.ml.analyze",
    "dev": "tsx scripts/dev.ts",
    "api:dev": "tsx watch --clear-screen=false services/api/server.ts",
    "orchestrator:dev": "tsx watch --clear-screen=false services/orchestrator/server.ts",
    "frontend:dev": "npm run dev --prefix frontend",
    "db:migrate": "tsx db/migrate.ts",
    "seed:results": "tsx scripts/seed-results.ts",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "lint:tests": "eslint \"app_tests/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "bullmq": "^5.30.0",
    "dockerode": "^4.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "uuid": "^11.0.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/dockerode": "^3.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.10.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
