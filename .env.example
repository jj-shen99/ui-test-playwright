# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# VictoriaMetrics
VM_URL=http://localhost:8428

# PostgreSQL
DATABASE_URL=postgresql://grafana_test:grafana_test@localhost:5432/grafana_ui_testing

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=test-artifacts
S3_REGION=us-east-1

# External Playwright test scripts repository
TEST_REPO_URL=https://code.devsnc.com/jianjun-shen/grafana-ui-testing
TEST_REPO_BRANCH=main

# Anthropic (LLM generation, server-side only)
ANTHROPIC_API_KEY=

# Secrets-at-rest encryption key (AES-256-GCM). REQUIRED in any non-local
# environment; if unset, an insecure development key is used and a warning is logged.
APP_SECRET_KEY=

# API
API_PORT=6199

# Frontend
VITE_API_URL=http://localhost:6199
